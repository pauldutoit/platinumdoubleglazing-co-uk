---
import siteConfig from '../data/site.config.json';
import cities from '../data/cities.json';
import intents from '../data/intents.json';

interface Props {
  /** Preselect a service from a slug (usually intent.slug). */
  preselectIntent?: string;
  /** Pre-fill the city context on the payload (city.name). */
  city?: string;
  /** Unique id suffix - only useful if two funnels ever end up on the same page. */
  idSuffix?: string;
}

const { preselectIntent = '', city = '', idSuffix = '' } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const cityLookup = cities.map((c) => ({ slug: c.slug, name: c.name }));
const intentLookup = intents.map((i) => ({ slug: i.slug, label: i.label }));

const propertyTypes = [
  { value: 'detached', label: 'Detached house' },
  { value: 'semi-detached', label: 'Semi-detached' },
  { value: 'terraced', label: 'Terraced house' },
  { value: 'flat', label: 'Flat / apartment' },
  { value: 'bungalow', label: 'Bungalow' },
  { value: 'other', label: 'Other' },
];

const timeframes = [
  { value: 'asap', label: 'As soon as possible' },
  { value: '1-3months', label: '1-3 months' },
  { value: '3-6months', label: '3-6 months' },
  { value: 'planning', label: '6+ months / researching' },
];

const unitCounts = ['1', '2', '3', '4', '5', '6-10', '11+'];
const formId = `quote-funnel${idSuffix ? `-${idSuffix}` : ''}`;
---

<div class="funnel-wrap">
  <div class="progress-bar" data-funnel-progress>
    <div class="progress-step is-active" data-step-marker="1"><span>1</span> Service</div>
    <div class="progress-step" data-step-marker="2"><span>2</span> Property</div>
    <div class="progress-step" data-step-marker="3"><span>3</span> Location</div>
    <div class="progress-step" data-step-marker="4"><span>4</span> Details</div>
  </div>

  <form id={formId} class="quote-funnel card" data-funnel novalidate>
    <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
    <input type="hidden" name="city" value={city} />
    <input type="hidden" name="preselect_intent" value={preselectIntent} />

    <fieldset class="form-step is-active" data-step="1">
      <legend><h2>What are you looking to install or replace?</h2></legend>
      <div class="option-grid">
        {intents.map((i) => (
          <label class="option-card">
            <input type="radio" name="service_type" value={i.slug} required checked={preselectIntent === i.slug} />
            <span class="option-icon">{i.icon ?? '□'}</span>
            <span class="option-label">{i.shortLabel ?? i.label}</span>
            <span class="option-desc">{i.priceFrom}</span>
          </label>
        ))}
        <label class="option-card">
          <input type="radio" name="service_type" value="not-sure" />
          <span class="option-icon">?</span>
          <span class="option-label">Not sure</span>
          <span class="option-desc">I'd like advice</span>
        </label>
      </div>
      <div class="step-nav">
        <button type="button" class="btn btn-accent" data-next>Continue &rarr;</button>
      </div>
    </fieldset>

    <fieldset class="form-step" data-step="2">
      <legend><h2>Tell us about your property</h2></legend>
      <div class="form-row">
        <div class="form-group">
          <label for={`unit_count-${formId}`}>How many units?</label>
          <select id={`unit_count-${formId}`} name="unit_count" required>
            <option value="">Select...</option>
            {unitCounts.map((n) => <option value={n}>{n === '1' ? '1 unit' : `${n} units`}</option>)}
          </select>
        </div>
        <div class="form-group">
          <label for={`property_type-${formId}`}>Property type</label>
          <select id={`property_type-${formId}`} name="property_type" required>
            <option value="">Select...</option>
            {propertyTypes.map((p) => <option value={p.value}>{p.label}</option>)}
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Do you own the property?</label>
        <p class="field-hint">We can only match homeowners with installers - insurance and warranties require the property owner's authorisation.</p>
        <div class="radio-row">
          <label class="radio-opt"><input type="radio" name="ownership" value="yes" required /> Yes, I own it</label>
          <label class="radio-opt"><input type="radio" name="ownership" value="renting" /> I'm renting</label>
          <label class="radio-opt"><input type="radio" name="ownership" value="other" /> Other</label>
        </div>
        <p class="disqualifier" data-disqualifier="ownership" hidden>Thanks for your interest. We only cover work authorised by the property owner - please have the owner submit the quote request.</p>
      </div>
      <div class="step-nav">
        <button type="button" class="btn btn-outline" data-prev>&larr; Back</button>
        <button type="button" class="btn btn-accent" data-next>Continue &rarr;</button>
      </div>
    </fieldset>

    <fieldset class="form-step" data-step="3">
      <legend><h2>Where is the property?</h2></legend>
      <div class="form-group">
        <label for={`address-${formId}`}>Address (house number &amp; street)</label>
        <input type="text" id={`address-${formId}`} name="address_line1" placeholder="e.g. 14 High Street" required />
      </div>
      <div class="form-group">
        <label for={`postcode-${formId}`}>Postcode</label>
        <input type="text" id={`postcode-${formId}`} name="postcode" placeholder="e.g. SW1A 1AA" maxlength="8" required />
        <span class="field-hint">We match you with installers who cover your postcode.</span>
      </div>
      <div class="form-group">
        <label>When are you looking to have the work done?</label>
        <p class="field-hint">We only match projects starting within the next 6 months.</p>
        <div class="option-grid-sm">
          {timeframes.map((t) => (
            <label class="option-sm">
              <input type="radio" name="timeframe" value={t.value} required />
              {t.label}
            </label>
          ))}
        </div>
        <p class="disqualifier" data-disqualifier="timeframe" hidden>Thanks for your interest. We only match projects starting within the next 6 months - come back closer to your project date.</p>
      </div>
      <div class="step-nav">
        <button type="button" class="btn btn-outline" data-prev>&larr; Back</button>
        <button type="button" class="btn btn-accent" data-next>Continue &rarr;</button>
      </div>
    </fieldset>

    <fieldset class="form-step" data-step="4">
      <legend><h2>Where should we send your quotes?</h2></legend>
      <p class="step-sub">Your details are shared only with vetted installers in your area.</p>
      <div class="form-group">
        <label for={`name-${formId}`}>Full name</label>
        <input type="text" id={`name-${formId}`} name="name" placeholder="e.g. John Smith" required />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for={`email-${formId}`}>Email address</label>
          <input type="email" id={`email-${formId}`} name="email" placeholder="you@example.com" required />
        </div>
        <div class="form-group">
          <label for={`phone-${formId}`}>Phone number</label>
          <input type="tel" id={`phone-${formId}`} name="phone" placeholder="07700 000000" required />
        </div>
      </div>
      <div class="form-group">
        <label for={`message-${formId}`}>Tell us about your project</label>
        <textarea id={`message-${formId}`} name="message" rows="3" required placeholder="e.g. Replace 5 sash windows in a Victorian terrace, prefer white finish" minlength="15" maxlength="800"></textarea>
        <span class="field-hint">A short brief helps installers give you a sharper quote.</span>
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="consent" value="1" required />
          I agree to be contacted about my quote by up to 3 vetted installers. See the <a href="/politique-de-confidentialite">privacy policy</a>.
        </label>
      </div>
      {turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
      )}
      <div class="step-nav">
        <button type="button" class="btn btn-outline" data-prev>&larr; Back</button>
        <button type="submit" class="btn btn-accent btn-lg">Get my free quotes &rarr;</button>
      </div>
      <p class="form-note">&#128274; Your information is secure and never sold to unrelated third parties.</p>
      <p class="form-status" data-status role="status"></p>
    </fieldset>
  </form>
</div>

<script type="application/json" class="quote-lookup-data" data-form-id={formId} set:html={JSON.stringify({ cities: cityLookup, intents: intentLookup })} />

{turnstileSiteKey && (
  <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<script define:vars={{ formId }}>
  const form = document.getElementById(formId);
  if (form) {
    const wrap = form.closest('.funnel-wrap');
    const lookupNode = document.querySelector(`.quote-lookup-data[data-form-id="${formId}"]`);
    const data = lookupNode ? JSON.parse(lookupNode.textContent || '{}') : { cities: [], intents: [] };

    // Query-string preselect from ?city= and ?intent= (used on /quote).
    const params = new URLSearchParams(window.location.search);
    const querySlug = params.get('city') || '';
    const queryIntent = params.get('intent') || '';
    const city = data.cities.find((c) => c.slug === querySlug);
    const intent = data.intents.find((i) => i.slug === queryIntent);
    if (intent) {
      const r = form.querySelector(`input[name="service_type"][value="${intent.slug}"]`);
      if (r) r.checked = true;
    }
    if (city) {
      form.querySelector('input[name="city"]').value = city.name;
    }

    // Step navigation
    const steps = Array.from(form.querySelectorAll('.form-step'));
    const markers = wrap ? Array.from(wrap.querySelectorAll('[data-step-marker]')) : [];
    let current = 1;

    const activate = (n) => {
      steps.forEach((s) => s.classList.toggle('is-active', parseInt(s.dataset.step, 10) === n));
      markers.forEach((m) => {
        const mn = parseInt(m.dataset.stepMarker, 10);
        m.classList.toggle('is-active', mn === n);
        m.classList.toggle('is-done', mn < n);
      });
      current = n;
      wrap?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // Hard qualifiers - block progress at step level when the answer would
    // produce a lead an installer can't act on.
    const DISQUALIFIERS = {
      ownership: (v) => v !== 'yes',
      timeframe: (v) => v === 'planning',
    };

    const checkDisqualifier = (step) => {
      for (const el of step.querySelectorAll('[data-disqualifier]')) {
        el.hidden = true;
      }
      for (const name of Object.keys(DISQUALIFIERS)) {
        const picked = step.querySelector(`input[name="${name}"]:checked`);
        if (!picked) continue;
        if (DISQUALIFIERS[name](picked.value)) {
          const msg = step.querySelector(`[data-disqualifier="${name}"]`);
          if (msg) msg.hidden = false;
          return false;
        }
      }
      return true;
    };

    const validateStep = (n) => {
      const step = steps.find((s) => parseInt(s.dataset.step, 10) === n);
      if (!step) return true;
      const inputs = step.querySelectorAll('[required]');
      for (const el of Array.from(inputs)) {
        if (el.type === 'radio') {
          const group = step.querySelectorAll(`input[name="${el.name}"]`);
          if (![...group].some((g) => g.checked)) {
            el.focus();
            return false;
          }
        } else if (!el.value) {
          el.focus();
          return false;
        }
        // Native minlength for textareas
        if (el.tagName === 'TEXTAREA' && el.minLength && el.value.trim().length < el.minLength) {
          el.focus();
          return false;
        }
      }
      return checkDisqualifier(step);
    };

    form.querySelectorAll('[data-next]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!validateStep(current)) return;
        activate(current + 1);
      });
    });
    form.querySelectorAll('[data-prev]').forEach((btn) => {
      btn.addEventListener('click', () => activate(current - 1));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validateStep(4)) return;
      const status = form.querySelector('[data-status]');
      const submitBtn = form.querySelector('button[type="submit"]');
      const fd = new FormData(form);
      const turnstileToken = fd.get('cf-turnstile-response') || '';

      const payload = {
        name: fd.get('name'),
        phone: fd.get('phone'),
        email: fd.get('email'),
        message: fd.get('message'),
        company: fd.get('company'),
        city: fd.get('city'),
        intent: fd.get('preselect_intent'),
        service_type: fd.get('service_type'),
        unit_count: fd.get('unit_count'),
        property_type: fd.get('property_type'),
        ownership: fd.get('ownership'),
        address_line1: fd.get('address_line1'),
        postcode: fd.get('postcode'),
        timeframe: fd.get('timeframe'),
        consent: fd.get('consent') === '1',
        turnstileToken,
      };

      if (submitBtn) submitBtn.disabled = true;
      if (status) { status.textContent = 'Sending...'; status.dataset.state = ''; }

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('request failed');
        form.reset();
        window.location.href = '/thank-you';
      } catch (err) {
        if (status) { status.textContent = 'Something went wrong, please try again in a moment.'; status.dataset.state = 'error'; }
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .funnel-wrap { display: block; }
  .progress-bar {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.25rem;
    margin-bottom: 1rem;
  }
  .progress-step {
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
    font-size: 0.72rem; font-weight: 700; color: var(--color-muted);
    text-align: center; padding: 0 0.15rem; line-height: 1.1;
  }
  .progress-step span {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.75rem; height: 1.75rem; border-radius: 50%;
    background: var(--color-border); color: var(--color-muted);
    font-weight: 800; font-size: 0.85rem;
  }
  .progress-step.is-active { color: var(--color-primary-dark); }
  .progress-step.is-active span { background: var(--color-primary); color: #fff; }
  .progress-step.is-done { color: var(--color-primary); }
  .progress-step.is-done span { background: var(--color-primary); color: #fff; }

  .quote-funnel { padding: 1.35rem 1.5rem; border: 0; }
  .form-step { border: 0; padding: 0; margin: 0; display: none; }
  .form-step.is-active { display: block; }
  .form-step legend { padding: 0; margin: 0 0 0.85rem; }
  .form-step legend h2 { font-size: 1.05rem; margin: 0; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 560px) { .form-row { grid-template-columns: 1fr; } }
  .form-group { display: grid; gap: 0.3rem; margin-bottom: 0.85rem; }
  .form-group label { font-weight: 700; font-size: 0.85rem; color: var(--color-ink); }
  .form-group input, .form-group select, .form-group textarea {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font: inherit; color: var(--color-ink); background: var(--color-surface);
  }
  .form-group textarea { resize: vertical; min-height: 5.5rem; font-family: inherit; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    outline: none; border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-tint);
  }
  .field-hint { font-size: 0.8rem; color: var(--color-muted); margin: 0; }
  .disqualifier {
    margin: 0.5rem 0 0; padding: 0.65rem 0.85rem;
    background: color-mix(in srgb, #b00020 8%, transparent);
    border-left: 3px solid #b00020;
    border-radius: var(--radius-sm);
    color: #7a0018; font-size: 0.85rem;
  }

  .option-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 0.5rem; }
  @media (max-width: 560px) { .option-grid { grid-template-columns: repeat(2, 1fr); } }
  .option-card {
    display: grid; gap: 0.2rem; padding: 0.75rem 0.5rem;
    border: 2px solid var(--color-border); border-radius: var(--radius-sm);
    text-align: center; cursor: pointer; background: var(--color-surface);
    transition: border-color 0.15s ease, background 0.15s ease;
    position: relative;
  }
  .option-card input { position: absolute; opacity: 0; pointer-events: none; }
  .option-card:hover { border-color: var(--color-primary); }
  .option-card:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-tint); }
  .option-icon { font-size: 1.15rem; }
  .option-label { font-weight: 700; color: var(--color-ink); font-size: 0.82rem; line-height: 1.2; }
  .option-desc { font-size: 0.7rem; color: var(--color-muted); }

  .option-grid-sm { display: grid; gap: 0.4rem; }
  .option-sm {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.85rem; border: 1px solid var(--color-border);
    border-radius: var(--radius-sm); cursor: pointer; background: var(--color-surface);
    font-size: 0.9rem;
  }
  .option-sm:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-tint); }
  .option-sm input { margin: 0; }

  .radio-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .radio-opt {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.4rem 0.7rem; border: 1px solid var(--color-border);
    border-radius: 999px; cursor: pointer; background: var(--color-surface);
    font-size: 0.85rem;
  }
  .radio-opt:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-tint); color: var(--color-primary-dark); font-weight: 700; }

  .checkbox-label { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.85rem; line-height: 1.45; }
  .checkbox-label input { margin-top: 0.15rem; }

  .step-sub { color: var(--color-muted); margin-bottom: 0.85rem; font-size: 0.88rem; }
  .step-nav { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap; }
  .step-nav .btn:only-child { margin-left: auto; }
  .btn-lg { padding: 0.85rem 1.5rem; font-size: 1rem; }
  .form-note { text-align: center; color: var(--color-muted); font-size: 0.78rem; margin: 0.75rem 0 0; }
  .form-status { font-size: 0.85rem; margin: 0.6rem 0 0; text-align: center; min-height: 1.1em; }
  .form-status[data-state='error'] { color: #b00020; }
</style>
