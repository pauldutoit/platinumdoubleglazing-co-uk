---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../data/site.config.json';
import intents from '../../data/intents.json';
import cities from '../../data/cities.json';
import intentEnrichment from '../../data/intentEnrichment.json';

export async function getStaticPaths() {
  return intents.map((intent) => ({
    params: { intentSlug: intent.slug },
    props: { intent },
  }));
}

const { intent } = Astro.props;
type IntentEnrichment = { hubIntro?: string; hubBody?: string[]; hubTips?: string[]; commonSpecs?: string };
const enrichment: IntentEnrichment = (intentEnrichment as Record<string, IntentEnrichment>)[intent.slug] ?? {};

// Group cities by region so the hub reads as a UK-wide index rather than a
// flat wall of 123 pill links.
const regions = [...new Set(cities.map((c) => c.region))].sort();
const citiesByRegion = Object.fromEntries(
  regions.map((r) => [r, cities.filter((c) => c.region === r)])
);

const pageUrl = `https://${siteConfig.domain}/services/${intent.slug}/`;
const priceRange = intent.basePriceRange
  ? `£${intent.basePriceRange[0].toLocaleString()} - £${intent.basePriceRange[1].toLocaleString()}`
  : intent.priceFrom;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: intent.label,
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  provider: { '@type': 'LocalBusiness', name: siteConfig.siteName },
  url: pageUrl,
  ...(intent.basePriceRange && {
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'GBP',
      lowPrice: intent.basePriceRange[0],
      highPrice: intent.basePriceRange[1],
    },
  }),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${siteConfig.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `https://${siteConfig.domain}/services/` },
    { '@type': 'ListItem', position: 3, name: intent.label, item: pageUrl },
  ],
};

const metaTitle = `${intent.label} UK - Compare Free Quotes | ${siteConfig.siteName}`;
const metaDescription = `${intent.label} across the UK from ${priceRange}. Free, no-obligation quotes from vetted local installers. ${cities.length} towns and cities covered.`;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="container service-hub" style="padding-top: 1.5rem;">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/">Home</a> / <a href="/areas">Services</a> / {intent.label}
    </nav>

    <div class="city-grid">
      <div class="city-main">
        <h1>{intent.label} across the UK</h1>
        <p class="lede">{intent.searchIntent.charAt(0).toUpperCase() + intent.searchIntent.slice(1)}. Compare free, no-obligation quotes from vetted installers, typically {priceRange} installed depending on your city and spec.</p>

        <ul class="local-trust-bar">
          <li>
            <strong>{siteConfig.aggregateRating?.value ?? '4.8'}/5</strong>
            <span>{siteConfig.aggregateRating?.count ?? '132'} homeowner reviews</span>
          </li>
          <li><strong>FENSA</strong><span>vetted installers</span></li>
          <li><strong>10yr</strong><span>typical guarantee</span></li>
          <li><strong>&lt; 24h</strong><span>quotes back to you</span></li>
        </ul>

        <div class="service-hub-intro">
          <h2>{intent.label} - what to expect</h2>
          {enrichment.hubIntro
            ? <p>{enrichment.hubIntro}</p>
            : <p>{intent.label} is one of the most requested services in our network. Prices depend on the number of units, glazing spec and your postcode.</p>}
          {(enrichment.hubBody ?? []).map((para) => <p>{para}</p>)}
          <p><strong>Typical UK price range for {intent.label.toLowerCase()}:</strong> {priceRange} installed. Actual figures for your city sit on the city page below.</p>
        </div>

        {enrichment.commonSpecs && (
          <div class="hub-specs">
            <h3>Popular specs for {intent.label.toLowerCase()}</h3>
            <p>{enrichment.commonSpecs}</p>
          </div>
        )}

        {enrichment.hubTips?.length ? (
          <div class="hub-tips">
            <h3>Before you commit - four things to check</h3>
            <ul>
              {enrichment.hubTips.map((tip) => <li>{tip}</li>)}
            </ul>
          </div>
        ) : null}

        <section class="section" style="padding-top: 1rem;">
          <div class="section-title">
            <h2>{intent.label} by area</h2>
            <p>Every city we cover for {intent.label.toLowerCase()}, grouped by region.</p>
          </div>
          {regions.map((region) => (
            <div class="hub-region">
              <h3>{region}</h3>
              <ul class="pill-list">
                {citiesByRegion[region].map((c) => (
                  <li><a class="pill" href={`/${intent.slug}-${c.slug}/`}>{intent.label} in {c.name}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </section>

        <div class="cta-banner">
          <h2>Ready to compare {intent.label.toLowerCase()} quotes?</h2>
          <a class="btn btn-accent" href={`/quote?intent=${intent.slug}`}>Get a free quote</a>
        </div>

        <section class="section" style="padding-top: 0;">
          <div class="section-title"><h2>Other services</h2></div>
          <ul class="pill-list">
            {intents.filter((i) => i.slug !== intent.slug).map((i) => (
              <li><a class="pill" href={`/services/${i.slug}/`}>{i.label}</a></li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="city-sidebar" aria-label="Get a quote">
        <div class="quote-sticky card">
          <h2>Free {intent.label.toLowerCase()} quote</h2>
          <p class="quote-sticky-sub">Compare vetted installers. 60 seconds, no cold calls.</p>
          <ul class="quote-sticky-trust">
            <li>&#10003; FENSA-registered installers</li>
            <li>&#10003; Up to 3 quotes to compare</li>
            <li>&#10003; 10-year typical guarantee</li>
          </ul>
          <a class="btn btn-accent btn-block" href={`/quote?intent=${intent.slug}`}>Start my free quote &rarr;</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .service-hub-intro { margin: 1.5rem 0 1rem; padding: 1.1rem 1.35rem; background: var(--color-surface-alt); border-radius: var(--radius-sm); border-left: 3px solid var(--color-primary); }
  .service-hub-intro h2 { font-size: 1.1rem; margin: 0 0 0.5rem; }
  .service-hub-intro p { margin: 0 0 0.5rem; }
  .service-hub-intro p:last-child { margin-bottom: 0; }
  .hub-region { margin-bottom: 1.5rem; }
  .hub-region h3 { font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .hub-specs { margin: 1.5rem 0; padding: 1.1rem 1.35rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .hub-specs h3 { font-size: 1rem; margin: 0 0 0.5rem; }
  .hub-specs p { margin: 0; font-size: 0.95rem; }
  .hub-tips { margin: 1.5rem 0; padding: 1.1rem 1.35rem; background: var(--color-surface-alt); border-left: 3px solid var(--color-accent); border-radius: var(--radius-sm); }
  .hub-tips h3 { font-size: 1rem; margin: 0 0 0.5rem; }
  .hub-tips ul { margin: 0; padding-left: 1.25rem; }
  .hub-tips li { margin-bottom: 0.4rem; }
</style>
