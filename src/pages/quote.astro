---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteFunnel from '../components/QuoteFunnel.astro';
import siteConfig from '../data/site.config.json';

const testimonial = siteConfig.testimonials?.[0];
---

<BaseLayout
  title={`Get a Free Quote | ${siteConfig.siteName}`}
  description="Free, no-obligation quotes from vetted local installers. Takes under a minute."
  indexable={false}
>
  <div class="quote-page container">
    <div class="quote-header">
      <h1 id="quote-headline">Get your free, no-obligation quotes</h1>
      <p class="quote-subline">Takes 60 seconds &bull; No cold calls &bull; Vetted installers only</p>
      {siteConfig.aggregateRating && (
        <p class="quote-trust">&#9733; {siteConfig.aggregateRating.value}/5 from {siteConfig.aggregateRating.count} reviews</p>
      )}
      {testimonial && (
        <blockquote class="quote-testimonial">
          <p>"{testimonial.quote}"</p>
          <cite>{testimonial.name}, {testimonial.location}</cite>
        </blockquote>
      )}
    </div>

    <QuoteFunnel idSuffix="page" />
  </div>
</BaseLayout>

<script>
  // Personalise headline from ?city=&intent=
  const params = new URLSearchParams(window.location.search);
  const cityParam = params.get('city') ?? '';
  const intentParam = params.get('intent') ?? '';
  if (cityParam || intentParam) {
    const headline = document.getElementById('quote-headline');
    if (headline) {
      const cityLabel = cityParam.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
      const intentLabel = intentParam.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
      headline.textContent = cityLabel && intentLabel
        ? `Get your free ${intentLabel} quotes for ${cityLabel}`
        : cityLabel
          ? `Get your free quotes for ${cityLabel}`
          : `Get your free ${intentLabel} quotes`;
    }
  }
</script>

<style>
  .quote-page { padding: 2rem 1.5rem 4rem; max-width: 780px; margin: 0 auto; }
  .quote-header { text-align: center; margin-bottom: 1.5rem; }
  .quote-header h1 { margin-bottom: 0.5rem; }
  .quote-subline { color: var(--color-muted); font-size: 0.95rem; margin-bottom: 0.5rem; }
  .quote-trust { font-weight: 700; color: var(--color-primary-dark); margin: 0.5rem 0; }
  .quote-testimonial {
    margin: 1.25rem 0; padding: 1rem 1.25rem; border-left: 3px solid var(--color-primary);
    background: var(--color-surface-alt); border-radius: var(--radius-sm); text-align: left;
  }
  .quote-testimonial p { margin: 0 0 0.4rem; font-style: italic; }
  .quote-testimonial cite { font-style: normal; font-weight: 700; font-size: 0.85rem; }
</style>
