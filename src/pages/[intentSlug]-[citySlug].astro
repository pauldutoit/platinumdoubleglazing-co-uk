---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/site.config.json';
import cities from '../data/cities.json';
import intents from '../data/intents.json';
import cityEnrichment from '../data/cityEnrichment.json';
import intentEnrichment from '../data/intentEnrichment.json';

export async function getStaticPaths() {
  const entries = await getCollection('cityContent');
  const byKey = new Map<string, typeof entries[number]>();
  for (const e of entries) byKey.set(`${e.data.intentSlug}::${e.data.citySlug}`, e);

  const paths = [];
  for (const city of cities) {
    for (const intent of intents) {
      const entry = byKey.get(`${intent.slug}::${city.slug}`) ?? null;
      paths.push({
        params: { intentSlug: intent.slug, citySlug: city.slug },
        props: { entry, cityMeta: city, intentMeta: intent },
      });
    }
  }
  return paths;
}

const { entry, cityMeta, intentMeta } = Astro.props as any;
const hasContent = !!entry;
const Content = hasContent ? (await render(entry)).Content : null;

const city: string = entry?.data.city ?? cityMeta.name;
const citySlug: string = entry?.data.citySlug ?? cityMeta.slug;
const intent: string = entry?.data.intent ?? intentMeta.label;
const intentSlug: string = entry?.data.intentSlug ?? intentMeta.slug;
// Fallback pages (no LLM body yet) are hard-set to noindex to avoid thin content.
const indexable: boolean = hasContent ? entry.data.indexable : false;
const metaTitle: string = entry?.data.metaTitle ?? `${intentMeta.label} in ${cityMeta.name} | ${siteConfig.siteName}`;
const priceRangeStr = intentMeta.basePriceRange
  ? `from £${Math.round(intentMeta.basePriceRange[0] * (cityMeta.pf ?? 1))}`
  : intentMeta.priceFrom ?? '';
const metaDescription: string = entry?.data.metaDescription ?? `${intentMeta.label} in ${cityMeta.name} ${priceRangeStr}. Free, no-obligation quotes from vetted local installers.`;

// Extract FAQ pairs from the FAQ section of the raw markdown body, so we can
// emit a FAQPage JSON-LD without touching the visible content (which is still
// rendered by <Content /> below). Format expected: a "Frequently asked" H2
// followed by `**Question?**\nAnswer.` pairs. Robust to no FAQ section and to
// answers spanning multiple lines.
function extractFaqs(markdown: string): { question: string; answer: string }[] {
  const afterHeading = markdown.split(/##\s+Frequently\s+asked[^\n]*\n/i)[1];
  if (!afterHeading) return [];
  const section = afterHeading.split(/\n##\s/)[0];
  const questions = [...section.matchAll(/\*\*([^*]+\?)\*\*/g)];
  const faqs: { question: string; answer: string }[] = [];
  for (let i = 0; i < questions.length; i++) {
    const q = questions[i];
    const start = (q.index ?? 0) + q[0].length;
    const end = i + 1 < questions.length ? (questions[i + 1].index ?? section.length) : section.length;
    const answer = section.slice(start, end).replace(/\s+/g, ' ').trim();
    const question = q[1]?.trim();
    if (question && answer) faqs.push({ question, answer });
  }
  return faqs;
}

const faqs = hasContent ? extractFaqs(entry.body ?? '') : [];
type IntentEnrichment = { hubIntro?: string; hubBody?: string[]; hubTips?: string[]; commonSpecs?: string };
const intentExtra: IntentEnrichment = (intentEnrichment as Record<string, IntentEnrichment>)[intentSlug] ?? {};

const cityRecord = cities.find((c) => c.slug === citySlug);
type CityEnrichment = { postcodes?: string[]; houseTypes?: string; notableAreas?: string[]; conservationNote?: string; dominantEra?: string };
const enrichment: CityEnrichment = (cityEnrichment as Record<string, CityEnrichment>)[citySlug] ?? {};
const postcodes: string[] = enrichment.postcodes ?? [];
const telHref = `tel:${siteConfig.phone.replace(/\s+/g, '')}`;
const intentRecord = intents.find((i) => i.slug === intentSlug);

// Internal links: other services in the same city, and this same service in
// nearby cities. Nearby uses the real `nearby` list on the city record when
// present (genuine local relevance); falls back to every other city for small
// demo datasets. These stay as plain links regardless of indexable status, so
// PageRank still flows to gated (noindex) pages through crawlable internal
// links - see the indexation-gate note in the README.
const otherIntentsSameCity = intents.filter((i) => i.slug !== intentSlug);
const nearbySlugs = cityRecord?.nearby?.length ? cityRecord.nearby : cities.filter((c) => c.slug !== citySlug).map((c) => c.slug);
const sameIntentOtherCities = nearbySlugs.map((slug) => cities.find((c) => c.slug === slug)).filter(Boolean);

const pageUrl = `https://${siteConfig.domain}/${intentSlug}-${citySlug}/`;
const serviceHubUrl = `https://${siteConfig.domain}/services/${intentSlug}/`;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: intent,
  areaServed: { '@type': 'City', name: city },
  provider: { '@type': 'LocalBusiness', name: siteConfig.siteName, telephone: siteConfig.phone },
  url: pageUrl,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${siteConfig.domain}/` },
    { '@type': 'ListItem', position: 2, name: intent, item: serviceHubUrl },
    { '@type': 'ListItem', position: 3, name: city, item: pageUrl },
  ],
};

const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---

<BaseLayout title={metaTitle} description={metaDescription} indexable={indexable}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="container city-page" style="padding-top: 1.5rem;">
    <nav class="breadcrumb" aria-label="breadcrumb"><a href="/">Home</a> / <a href={`/services/${intentSlug}/`}>{intent}</a> / {city}</nav>

    <div class="city-grid">
      <div class="city-main">
        <h1>{intent} in {city}</h1>

        <ul class="local-trust-bar">
          <li>
            <strong>{siteConfig.aggregateRating?.value ?? '4.8'}/5</strong>
            <span>{siteConfig.aggregateRating?.count ?? '132'} homeowner reviews</span>
          </li>
          <li>
            <strong>FENSA</strong>
            <span>vetted local installers</span>
          </li>
          <li>
            <strong>10yr</strong>
            <span>typical guarantee</span>
          </li>
          <li>
            <strong>&lt; 24h</strong>
            <span>quotes back in {city}</span>
          </li>
        </ul>

        {intentRecord?.priceFrom && <p class="price-from">{intentRecord.priceFrom}</p>}

        <table class="price-table">
          <thead><tr><th>Service</th><th>Typical price in {city}</th></tr></thead>
          <tbody>
            {intents.map((i) => {
              const pf = cityRecord?.pf ?? 1;
              const price = i.basePriceRange
                ? `£${Math.round(i.basePriceRange[0] * pf).toLocaleString()} - £${Math.round(i.basePriceRange[1] * pf).toLocaleString()}`
                : i.priceFrom;
              return (
                <tr class:list={{ 'is-current': i.slug === intentSlug }}>
                  <td><a href={`/${i.slug}-${citySlug}/`}>{i.label}</a></td>
                  <td>{price}</td>
                </tr>
              );
            })}
          </tbody>
        </table>

        {hasContent && Content ? <Content /> : (
          <div class="fallback-body">
            <p class="lede">Looking for {intent.toLowerCase()} in {city}? Compare free, no-obligation quotes from vetted local installers in your area. Typical prices in {city} sit around {priceRangeStr} depending on unit count and specification.</p>
            {intentExtra.hubIntro && <p>{intentExtra.hubIntro}</p>}
            {(intentExtra.hubBody ?? []).slice(0, 1).map((para) => <p>{para}</p>)}
            {intentExtra.commonSpecs && (
              <>
                <h2>Popular specs for {intent.toLowerCase()}</h2>
                <p>{intentExtra.commonSpecs}</p>
              </>
            )}
          </div>
        )}

        {(enrichment.houseTypes || enrichment.notableAreas?.length || enrichment.conservationNote || enrichment.dominantEra) && (
          <section class="local-context">
            <h2>Windows and doors in {city} - local context</h2>
            {enrichment.houseTypes && <p>{enrichment.houseTypes}</p>}
            {enrichment.dominantEra && (
              <p><strong>Dominant era of housing stock:</strong> {enrichment.dominantEra}</p>
            )}
            {enrichment.conservationNote && (
              <p class="local-context-note"><strong>Heritage note:</strong> {enrichment.conservationNote}</p>
            )}
            {enrichment.notableAreas?.length ? (
              <div class="local-context-areas">
                <strong>Neighbourhoods and nearby areas we cover:</strong>
                <ul>
                  {enrichment.notableAreas.map((a) => <li>{a}</li>)}
                </ul>
              </div>
            ) : null}
          </section>
        )}

        {postcodes.length > 0 && (
          <section class="postcodes-box">
            <h2>Postcodes we cover in {city}</h2>
            <ul class="postcode-pills">
              {postcodes.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <p class="postcodes-note">Not seeing your postcode? {siteConfig.phoneEnabled !== false ? 'Call us anyway - ' : 'Request a quote anyway - '}we likely still cover it.</p>
          </section>
        )}

        <div class="cta-banner">
          <h2>Need {intent.toLowerCase()} in {city} today?</h2>
          {siteConfig.phoneEnabled !== false ? (
            <a class="btn btn-accent" href={telHref}>Call {siteConfig.phone}</a>
          ) : (
            <a class="btn btn-accent" href={`/quote?city=${citySlug}&intent=${intentSlug}`}>Get a free quote</a>
          )}
        </div>

        <section class="section" style="padding-top: 0;">
          <div class="section-title"><h2>Other services in {city}</h2></div>
          <ul class="pill-list">
            {otherIntentsSameCity.map((i) => (
              <li><a class="pill" href={`/${i.slug}-${citySlug}/`}>{i.label} in {city}</a></li>
            ))}
          </ul>
        </section>

        <section class="section" style="padding-top: 0;">
          <div class="section-title"><h2>{intent} in nearby areas</h2></div>
          <ul class="pill-list">
            {sameIntentOtherCities.map((c) => (
              <li><a class="pill" href={`/${intentSlug}-${c.slug}/`}>{intent} in {c.name}</a></li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="city-sidebar" aria-label="Get a quote">
        <div class="quote-sticky card">
          <h2>Free {intent.toLowerCase()} quote in {city}</h2>
          <p class="quote-sticky-sub">Compare vetted installers. 60 seconds, no cold calls.</p>
          <ul class="quote-sticky-trust">
            <li>&#10003; FENSA-registered installers</li>
            <li>&#10003; Up to 3 quotes to compare</li>
            <li>&#10003; 10-year typical guarantee</li>
          </ul>
          <a class="btn btn-accent btn-block" href={`/quote?city=${citySlug}&intent=${intentSlug}`}>Start my free quote &rarr;</a>
          {siteConfig.phoneEnabled !== false && (
            <p class="quote-sticky-alt">or call <a href={telHref}>{siteConfig.phone}</a></p>
          )}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
